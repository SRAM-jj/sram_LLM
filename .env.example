# S.RAM! LLM 서버 환경변수 설정
# 이 파일을 복사해서 .env 로 저장 후 값을 수정하세요
# cp .env.example .env

# ── API 인증 ──────────────────────────────────────────────────
# 비어있으면 인증 비활성화 (개발 환경 전용)
API_KEY=your-secret-api-key

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT=60
RATE_WINDOW=60

# ── MQTT 설정 ────────────────────────────────────────────────
MQTT_BROKER=192.168.0.100
MQTT_PORT=1883
MQTT_TOPIC=sram/emergency_stop
MQTT_USERNAME=sram
MQTT_PASSWORD=your-mqtt-password
MQTT_USE_TLS=false

# ── Tier3 Ubuntu 대시보드 ────────────────────────────────────
DASHBOARD_URL=http://192.168.0.101:8001

# ── LLM 설정 ────────────────────────────────────────────────
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT=10

# ── ROS2 노드 → LLM 서버 URL ────────────────────────────────
# 배포 환경에서는 HTTPS URL로 변경
LLM_SERVER_URL=http://localhost:8000/analyze

# ── InfluxDB 설정 ────────────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=토큰입력
INFLUX_ORG=sram
INFLUX_BUCKET=threat_logs
