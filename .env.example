# S.RAM! LLM 서버 환경변수 설정
# 이 파일을 복사해서 .env 로 저장 후 값을 수정하세요
# cp .env.example .env

# Raspberry Pi (Tier2) IP 주소
MQTT_BROKER=192.168.0.100

# MQTT 포트 (기본값 1883)
MQTT_PORT=1883

# MQTT 긴급정지 토픽
MQTT_TOPIC=sram/emergency_stop

# Tier3 Ubuntu 대시보드 URL
DASHBOARD_URL=http://192.168.0.101:8001

# 사용할 Ollama 모델
LLM_MODEL=llama3.1:8b

# PostgreSQL 데이터베이스 설정
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sram
DB_USER=sram_user
DB_PASSWORD=비밀번호입력
