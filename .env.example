# S.RAM! LLM 서버 환경변수 설정
# 이 파일을 복사해서 .env 로 저장 후 값을 수정하세요
# cp .env.example .env

# Raspberry Pi (Tier2) IP 주소
MQTT_BROKER=192.168.0.100

# MQTT 포트 (기본값 1883)
MQTT_PORT=1883

# MQTT 긴급정지 토픽
MQTT_TOPIC=sram/emergency_stop

# Tier3 Ubuntu 대시보드 URL
DASHBOARD_URL=http://192.168.0.101:8001

# 사용할 Ollama 모델
LLM_MODEL=llama3.1:8b

# LLM 응답 타임아웃 (초) — 초과 시 규칙 기반 단독 판단으로 전환
LLM_TIMEOUT=10

# InfluxDB 설정
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=토큰입력
INFLUX_ORG=sram
INFLUX_BUCKET=threat_logs
